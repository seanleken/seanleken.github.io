---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found | Sean Pertet" description="That page doesn't exist." noindex>
  <main>
    <div class="wrap sec-pad">
      <div class="sec-head">
        <span class="eyebrow">// 404</span>
        <h2>That page doesn&apos;t exist.</h2>
      </div>
      <p class="intro">
        The link may be out of date, or the page may have moved. Try the writing
        index or head back to the start.
      </p>
      <div class="cta-row">
        <a href="/" class="btn primary">Back home</a>
        <a href="/writing" class="btn">Read the writing</a>
      </div>
    </div>
  </main>
</Base>
