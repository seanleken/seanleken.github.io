---
// Wraps every fenced code block so it can carry a copy button. rehype-pretty-code
// has already produced the <pre> that lands in the slot; this only adds chrome.
---

<div class="cb-wrap">
  <button class="copy" aria-label="Copy code">Copy</button>
  <pre><slot /></pre>
</div>

<script>
  // One delegated listener for every code block on the page.
  document.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement)?.closest<HTMLButtonElement>(".cb-wrap .copy");
    if (!button) return;

    const pre = button.parentElement?.querySelector("pre");
    if (!pre) return;

    try {
      await navigator.clipboard.writeText(pre.innerText);
      button.textContent = "Copied";
    } catch {
      button.textContent = "Press ⌘C";
    }
    setTimeout(() => (button.textContent = "Copy"), 1400);
  });
</script>
